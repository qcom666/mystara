# Подробнее о правилах игнорирования: https://help.github.com/articles/ignoring-files/

# зависимости
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# тесты
/coverage

# next.js
/.next/
/out/

# продакшен-сборка
/build

# прочее
.DS_Store
*.pem

# отладочные журналы
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# файлы окружения (секреты, в репозиторий не попадают)
.env*

# vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# шаблон переменных окружения хранится в репозитории (секретов в нём нет)
!.env.example

# Локальные копии базы (db/backup.ps1): дампы данных в репозиторий не попадают
/db/backups/

# Создаётся скриптом db/mystara/studio.ps1 по живой базе
/db/mystara/studio/schema.prisma

# Архивы с исходниками для владельца (не коммитятся)
/exports/
