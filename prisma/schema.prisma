// Схема Prisma.
// Содержимое карт и раскладов таро в базе намеренно НЕ хранится: это статические данные
// в src/modules/tarot/domain. Reading и ReadingCard ссылаются на них обычными строковыми id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Стандартные модели Auth.js (сессии на JWT, но Account и User всё равно используются) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  // Необязателен: у пользователя, пришедшего только из Telegram, e-mail нет вовсе. Хотя бы одно
  // из полей (email, telegramId) всегда заполнено; это проверяет код приложения, а не схема,
  // потому что Prisma не умеет выражать ограничение «одно или другое».
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // заполняется только при регистрации по паролю; у входивших через OAuth или Telegram пусто

  // Личность из Telegram Mini App (см. src/lib/telegram/). Заполняется при первом
  // открытии Mini App.
  telegramId       String? @unique
  telegramUsername String?
  telegramPhotoUrl String?

  // Общая для нумерологии и астрологии (см. modules/numerology, modules/astrology).
  // Хранится в профиле один раз, чтобы вернувшемуся пользователю не вводить её заново, но оба
  // сценария работают и без сохранения (так же без регистрации, как и таро).
  birthDate DateTime?

  language String @default("en")
  timezone String @default("UTC")

  // Подтверждение согласия на обработку персональных данных (152-ФЗ, ст. 9): когда оно дано
  // и по какой версии политики (src/lib/legal/operator.ts). Пусто у аккаунтов, созданных
  // до того, как согласие стали фиксировать.
  privacyConsentAt      DateTime?
  privacyPolicyVersion  String?

  // Натальная карта платная (см. lib/pricing/natal-chart-pricing.ts): здесь хранится остаток
  // кредитов. Одна построенная карта списывает 1, оплаченная покупка начисляет
  // NATAL_CHART_PACK_CREDITS. По умолчанию 0: бесплатного пробного периода нет, но менять
  // это решение в коде легко.
  natalChartCredits Int @default(0)

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  readings           Reading[]
  favorites          Favorite[]
  subscription       Subscription?
  numerologyReadings NumerologyReading[]
  astrologyReadings  AstrologyReading[]
  natalChartReadings NatalChartReading[]
  purchases           Purchase[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Модели продукта ---

enum Orientation {
  UPRIGHT
  REVERSED
}

enum FavoriteType {
  CARD
  SPREAD
}

enum PlanTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model Reading {
  id         String   @id @default(cuid())
  userId     String
  spreadId   String // ссылка на spreads.data.ts в modules/tarot/domain, а не на строку в базе
  question   String?
  seed       String // только происхождение расклада: показ всегда идёт по строкам ReadingCard, повторного розыгрыша нет
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards             ReadingCard[]
  aiInterpretation  AIInterpretation?

  @@index([userId, createdAt])
}

model ReadingCard {
  id          String      @id @default(cuid())
  readingId   String
  cardId      String // ссылка на набор карт в modules/tarot/domain
  positionId  String // ссылка на id позиции в раскладе
  orientation Orientation
  order       Int

  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId])
}

model AIInterpretation {
  id                  String   @id @default(cuid())
  readingId           String   @unique
  provider            String
  summary             String   @db.Text
  overall             String   @db.Text
  themes              String[]
  advice              String[]
  challenges          String[]
  cardInterpretations Json // массив { positionId, cardId, interpretation }
  generatedAt         DateTime @default(now())

  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  type      FavoriteType
  targetId  String // id карты или расклада, в зависимости от `type`
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  tier               PlanTier           @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  provider           String? // например "yookassa"; пусто, пока платёжный провайдер не подключён
  externalId         String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Нумерология и астрология ---
// Тот же принцип, что и у таро: толкования (текст числа жизненного пути, описание знака
// зодиака, данные для фактов об актёрах) лежат статическими данными в modules/numerology
// и modules/astrology, а не строками в базе. Здесь сохраняются только собственные
// рассчитанные результаты пользователя.

model NumerologyReading {
  id             String   @id @default(cuid())
  userId         String
  birthDate      DateTime
  lifePathNumber Int
  // Число дня рождения всегда считается по одной только birthDate, а fullName и восемь
  // чисел, выведенных из имени, заполнены лишь тогда, когда пользователь ввёл имя хотя бы
  // с одной буквой, которую можно посчитать (см. hasCalculableLetters). Обе системы
  // хранятся рядом: вкладка «Пифагор / Халдейская» лишь способ показа, а не данные,
  // поэтому запоминать «какая система» не нужно.
  birthdayNumber         Int?
  fullName               String?
  pythagoreanExpression  Int?
  pythagoreanSoulUrge    Int?
  pythagoreanPersonality Int?
  pythagoreanMaturity    Int?
  chaldeanExpression     Int?
  chaldeanSoulUrge       Int?
  chaldeanPersonality    Int?
  chaldeanMaturity       Int?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AstrologyReading {
  id        String   @id @default(cuid())
  userId    String
  birthDate DateTime
  sunSign   String // id знака зодиака, например "aries"; ссылка на данные modules/astrology
  // "day" | "night" (см. Sect в modules/astrology/domain/types.ts); пусто, если в форме
  // AstrologyInputForm выбрано «Не знаю».
  sect      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// --- Натальная карта (платная) ---

model NatalChartReading {
  id         String   @id @default(cuid())
  userId     String
  birthDate  DateTime // момент рождения, приведённый к UTC
  hasExactTime Boolean // false = время рождения неизвестно: дома, асцендент и MC не считались, а не угадывались
  birthPlace String? // подпись для показа, например "Москва, Россия"; пусто при ручном вводе широты и долготы
  latitude   Float
  longitude  Float
  timezone   String // идентификатор зоны IANA, по которому местное время переводилось в UTC, например "Europe/Moscow"
  chart      Json // полностью рассчитанная NatalChart (см. modules/astrology/domain/types.ts); версионируемое содержимое, реляционная модель не нужна
  source     String   @default("credit") // чем оплачено построение: "credit" (кредит пакета) | "premium" (недельное построение по подписке Premium)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Покупки: пакет натальных карт и период Premium. Таблица исторически называется NatalChartPurchase,
// поэтому модель привязана к ней через @@map: данные и имена ограничений остаются прежними.
model Purchase {
  id             String   @id @default(cuid())
  userId         String
  product        String   @default("natal_pack") // "natal_pack" (пакет натальных карт) | "premium_month" (период Premium)
  creditsGranted Int // сколько кредитов начисляется при оплате (0 для Premium)
  amount         Int // целое число единиц `currency`: 1000 для пакета за 1000 ₽; при таких ценах дробные доли не нужны
  currency       String // "XTR" (Звёзды Telegram) | "RUB"; см. lib/payments/catalog.ts
  provider       String? // "stars" | "yookassa" (lib/payments/catalog.ts)
  externalId     String? // идентификатор транзакции у провайдера, проставляется при оплате
  status         String // "pending" | "paid" | "failed"
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Транзакцию провайдера можно записать только один раз (Postgres допускает много NULL, так что неоплаченные строки не мешают).
  @@unique([provider, externalId])
  @@index([userId, createdAt])
  @@map("NatalChartPurchase")
}

// --- Админ-панель ---

// Журнал действий администратора: кто, над кем и что сделал. Внешних ключей к User нет намеренно:
// журнал должен пережить удаление аккаунта (и администратора, и пользователя).
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String // "credits.adjust" | "premium.extend" | "premium.end"
  details      Json // параметры действия и причина, указанная администратором
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

