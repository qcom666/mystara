# Copy to .env and fill in. Nothing here is a real secret.

# --- Database (Phase 4) ---
# Any Postgres instance Prisma can reach (Neon, Supabase, Vercel Postgres, local Docker...).
# Auth, saving readings, and history are disabled with a clear error until this is set.
DATABASE_URL="postgresql://user:password@localhost:5432/taro_project"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional — Google sign-in is only registered if both are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI interpretation (Phase 3) ---
# Optional — without this, AI interpretation falls back to the deterministic
# offline MockProvider automatically. No code changes needed either way.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Telegram Mini App (Phase 6) ---
# From @BotFather after creating a bot (`/newbot`), then registering this
# app's URL as its Mini App (`/newapp` or Bot Settings > Mini App).
# Required for Telegram sign-in to work; the app runs fine as a regular
# website without it — Telegram-specific UI just never activates.
TELEGRAM_BOT_TOKEN=""
# Shared secret for the bot webhook (/api/telegram/webhook). Any long random string;
# the same value is passed to Telegram as secret_token when registering the webhook.
# Without it the webhook refuses every request.
TELEGRAM_WEBHOOK_SECRET=""

# --- Payments (Natal Chart pack) ---
# Telegram Stars need nothing beyond TELEGRAM_BOT_TOKEN above. Cards/SBP and crypto are
# website-only (Telegram requires Stars for digital goods inside its apps). Each method
# switches itself on when its credentials are set. All of them need DATABASE_URL.
# ЮKassa — shop id and secret key from the ЮKassa merchant cabinet; set the HTTP
# notification URL to <site>/api/payments/yookassa/webhook (event: payment.succeeded).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Crypto Pay — API token of your app in @CryptoBot (Crypto Pay > My Apps); set its
# webhook URL to <site>/api/payments/cryptobot/webhook.
CRYPTOBOT_API_TOKEN=""

# --- Legal: personal-data operator (152-ФЗ) ---
# Shown in the privacy policy and consent form (/privacy, /consent). Until
# these are filled in, those pages display obvious [placeholders] — fill them
# in with the real ИП / самозанятый / юрлицо details BEFORE going public.
NEXT_PUBLIC_OPERATOR_NAME=""
NEXT_PUBLIC_OPERATOR_REGISTRATION=""
NEXT_PUBLIC_OPERATOR_ADDRESS=""
NEXT_PUBLIC_OPERATOR_EMAIL=""
