# Скопируйте в .env и заполните. Настоящих секретов в этом файле нет.

# --- База данных ---
# Любой Postgres, до которого достаёт Prisma (Neon, Supabase, локальный сервер и т. д.).
# Пока переменная не задана, вход, сохранение раскладов и история отвечают понятной ошибкой
# «не настроено», а остальное работает.
DATABASE_URL="postgresql://user:password@localhost:5432/taro_project"
# Необязательно: прямое соединение (без пулера) для миграций при сборке на Vercel.
# Если не задано, миграции идут через DATABASE_URL.
DATABASE_URL_UNPOOLED=""
# Необязательно: размер пула соединений на один экземпляр функции (по умолчанию 3).
DATABASE_POOL_MAX=""

# --- Адрес сайта ---
# Публичный адрес без слэша в конце. Используется в метаданных, sitemap, robots и в ссылках
# политики. Подставляется на этапе сборки, поэтому после смены нужен новый деплой.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js ---
# Сгенерировать: npx auth secret
AUTH_SECRET="замените-на-случайный-секрет-из-32-байт"

# Необязательно: вход через Google включается, только если заданы обе переменные.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- ИИ-толкование ---
# Необязательно: без ключа толкование автоматически строится детерминированным офлайн-
# провайдером из традиционных значений карт. Менять код не нужно ни в том, ни в другом случае.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Telegram Mini App ---
# Токен выдаёт @BotFather после создания бота (`/newbot`); затем адрес приложения
# регистрируется как Mini App бота (`/newapp` или Bot Settings > Mini App).
# Нужен для входа через Telegram; без него приложение работает как обычный сайт,
# а Telegram-интерфейс просто не включается.
TELEGRAM_BOT_TOKEN=""
# Общий секрет вебхука бота (/api/telegram/webhook). Любая длинная случайная строка;
# то же значение передаётся Telegram как secret_token при регистрации вебхука.
# Без него вебхук отклоняет любые запросы.
TELEGRAM_WEBHOOK_SECRET=""

# --- Платежи (пакет натальных карт) ---
# Для Звёзд Telegram нужен только TELEGRAM_BOT_TOKEN выше. Карты и СБП доступны только на сайте
# (внутри своих приложений Telegram требует Звёзды для цифровых товаров). Каждый способ
# включается сам, как только заданы его ключи. Всем способам нужен DATABASE_URL.
# ЮKassa: идентификатор магазина и секретный ключ из личного кабинета ЮKassa; адрес
# HTTP-уведомлений — <адрес сайта>/api/payments/yookassa/webhook (событие payment.succeeded).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- Юридические данные: оператор персональных данных (152-ФЗ) ---
# Показываются в политике конфиденциальности и в форме согласия (/privacy, /consent). Пока значения
# не заполнены, на этих страницах видны заметные [заглушки]: заполните их реальными данными
# ИП / самозанятого / юрлица ДО публичного запуска.
NEXT_PUBLIC_OPERATOR_NAME=""
NEXT_PUBLIC_OPERATOR_REGISTRATION=""
NEXT_PUBLIC_OPERATOR_ADDRESS=""
NEXT_PUBLIC_OPERATOR_EMAIL=""
# Телефон для обращений, например +7 962 454-00-15 (необязательно; пока не задан, нигде не показывается)
NEXT_PUBLIC_OPERATOR_PHONE=""
# Telegram-аккаунт службы поддержки, например @Mystara_Support (необязательно)
NEXT_PUBLIC_OPERATOR_TELEGRAM=""

# --- Админ-панель (/admin) ---
# Кто видит панель: внутренние идентификаторы аккаунтов через запятую. Свой ID виден в личном кабинете
# (/account, вкладка «Обзор», строка «ID аккаунта»). По e-mail администратора определять нельзя:
# подтверждения почты в сервисе нет. Пока список пуст, панель недоступна никому.
ADMIN_USER_IDS=""
# То же по числовому идентификатору Telegram (необязательно).
ADMIN_TELEGRAM_IDS=""
